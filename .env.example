# Supabase (frontend uses the public anon key — RLS enforced)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ifoodmap backend API (Railway). Holds the Gemini + Supabase service-role keys.
# Local dev: http://localhost:8787
# Production (Vercel): the Railway public URL of the `api` service,
#   e.g. https://ifoodmap-api-production.up.railway.app
VITE_API_URL=
